# Name shown on the page.
APP_NAME=Auto Poster

# Public URL of the site, e.g. https://poster.example.com (used for Stripe's
# return links and secure cookies). Optional, but set it in production.
BASE_URL=

# Comma-separated emails that get the Admin page. The first account ever
# created is an admin too.
ADMIN_EMAILS=

# 0 = nobody new can sign up (existing accounts still work).
SIGNUPS_OPEN=1

# Time zone for new accounts if the browser doesn't send one.
DEFAULT_TIMEZONE=America/New_York

# Where accounts, WhatsApp logins and scheduled posts are stored. On Railway
# this defaults to /data — mount a volume there so they survive deploys.
DATA_DIR=

# 1 = log posts instead of sending (for testing).
DRY_RUN=

# ---- Payments (leave off until you're ready to charge) ----
# 1 = enforce the Free/Pro limits in lib/billing.js and show "Upgrade".
# Off = everyone gets Pro for free.
BILLING_ENABLED=
STRIPE_SECRET_KEY=
# The Price id of your monthly Pro product (price_...).
STRIPE_PRICE_ID=
# Signing secret of the webhook pointing at <BASE_URL>/api/billing/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# What the page says Pro costs.
PRO_PRICE_LABEL=$9 / month
